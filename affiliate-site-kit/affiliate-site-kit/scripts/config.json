{
  "priceStaleDays": 14,
  "minSpecs": 3,
  "minFlawLength": 8,
  "placeholderHosts": [
    "example.com",
    "example.org",
    "localhost"
  ],
  "installCategories": [
    "washer",
    "water-heater",
    "air-conditioner",
    "dishwasher",
    "refrigerator",
    "water-purifier",
    "smart-lock",
    "massage-chair",
    "dryer",
    "range-hood",
    "safe",
    "fitness-equipment",
    "furniture"
  ],
  "priceHistory": {
    "windowDays": 30,
    "minPoints": 3,
    "minSpanDays": 14
  },
  "linkCheck": {
    "delayMs": 1500,
    "maxHops": 5,
    "timeoutMs": 10000,
    "userAgent": "affiliate-link-check/1.0 (site owner health check)"
  },
  "provider": "manual",
  "maxPriceChangePct": 40,
  "tagVocabulary": [
    "寵物友善",
    "除臭",
    "安全鎖",
    "靜音",
    "大坪數",
    "小坪數",
    "預算友善",
    "節能",
    "省空間",
    "易清潔"
  ],
  "minIntentProducts": 2,
  "providers": {
    "coupang": {
      "urlTemplate": "",
      "method": "GET",
      "tokenEnv": "COUPANG_API_TOKEN",
      "tokenHeader": "Authorization",
      "tokenPrefix": "Bearer ",
      "pricePath": "",
      "dateFormatNote": "",
      "delayMs": 800,
      "timeoutMs": 10000
    }
  },
  "importer": {
    "userAgent": "affiliate-product-importer/1.0 (site owner; low-rate metadata reader)",
    "delayMs": 3000,
    "timeoutMs": 15000,
    "maxRedirects": 4,
    "maxHtmlBytes": 2097152,
    "maxImageBytes": 8388608,
    "maxImages": 3,
    "minImageSide": 300,
    "minReviewSample": 10,
    "approvedImageLicenses": [
      "owned",
      "official",
      "licensed"
    ]
  },
  "productSources": {
    "_說明": "蝦皮／酷澎的商品資料只走官方 API，待官方文件後實作（見 scripts/providers/*-product.mjs）。這裡不放金鑰。",
    "shopee": {
      "enabled": false
    },
    "coupang": {
      "enabled": false
    }
  }
}
