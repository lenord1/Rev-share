---
// 離站挽回：底部抽屜（手機）／置中卡片（桌機）。每個瀏覽工作階段最多一次。
// 文案全部依資料產生：只有「有已核對的限時特價」的商品才會渲染，沒有就整個不輸出。
import { priceBreakdown } from '../lib/pricing.mjs';
import { productName, primaryChannel } from '../lib/catalog.mjs';

interface Props { product?: any; }
const { product: p } = Astro.props;
const b = p ? priceBreakdown(p) : null;
const ok = p && !p.priceUnverified && b && b.active && b.discount > 0 && b.final < b.price;
const fmt = new Intl.NumberFormat('zh-TW', { style: 'currency', currency: 'TWD', maximumFractionDigits: 0 });
---
{ok && (
  <div id="exit-modal" class="fixed inset-0 z-50 hidden items-end justify-center bg-slate-900/40 backdrop-blur-sm md:items-center" role="dialog" aria-modal="true" aria-labelledby="exit-title">
    <div class="w-full max-w-md rounded-t-2xl bg-white p-5 shadow-2xl md:rounded-2xl">
      <h2 id="exit-title" class="text-lg font-extrabold text-slate-900">等等！先看一下目前的特價</h2>
      <p class="mt-2 text-sm text-slate-600">{productName(p)} 目前{p.promoBadge || '優惠'}，現折 {fmt.format(b.discount)}，到手價 <b class="text-rose-600">{fmt.format(b.final)}</b>{p.promoValidUntil ? `（活動至 ${String(p.promoValidUntil).slice(0, 10).replaceAll('-', '/')}）` : ''}。活動與價格以蝦皮頁面為準。</p>
      <a class="mt-4 flex min-h-12 w-full items-center justify-center rounded-lg bg-gradient-to-r from-orange-500 to-orange-600 px-4 font-bold text-white no-underline" href={`/go/${primaryChannel(p)}-${p.modelCode}`} rel="sponsored nofollow noopener" data-track="go" data-channel={primaryChannel(p)} data-code={p.modelCode} data-slot="exit">👉 前往官方旗艦館看特價 ➔</a>
      <button type="button" data-close class="mt-2 min-h-10 w-full text-sm text-slate-500">我再看看</button>
    </div>
  </div>
)}
<script>
  const m = document.getElementById('exit-modal');
  if (m) {
    const KEY = 'exit.shown';
    let seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch {}
    const close = () => { m.classList.add('hidden'); m.classList.remove('flex'); };
    document.addEventListener('exit-intent', () => {
      if (seen) return;
      seen = true;
      try { sessionStorage.setItem(KEY, '1'); } catch {}
      m.classList.remove('hidden'); m.classList.add('flex');
    });
    m.addEventListener('click', (e) => { if (e.target === m || (e.target as Element).closest('[data-close]')) close(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>
