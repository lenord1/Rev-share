---
// 3 秒選購精靈：品類（預設選第一個）→ 最多 3 題大按鈕 → 一台推薦。資料由首頁以 #catalog 內嵌，client 不 fetch。
---
<section class="finder" id="finder" aria-label="選購精靈">
  <div class="cats" id="finder-cats" role="group" aria-label="選擇品類"></div>
  <div class="steps" id="finder-steps" aria-hidden="true"></div>
  <div id="finder-body" aria-live="polite"></div>
  <noscript><p class="note">選購精靈需要 JavaScript；你也可以直接看下方的主力推薦。</p></noscript>
</section>

<script>
  import { Profile } from '../lib/profile.js';
  import { questionsFor, pickProducts } from '../lib/finder.js';
  import { readCatalog, fmt, esc } from '../lib/client.js';
  import { histLine } from '../lib/catalog.mjs';

  const { products = [], categories = [], channels = {} } = readCatalog();
  const catsEl = document.getElementById('finder-cats');
  const stepsEl = document.getElementById('finder-steps');
  const bodyEl = document.getElementById('finder-body');

  const groups = [...new Set(categories.map((c) => c.group).filter(Boolean))];
  const state = { category: categories[0]?.slug, group: categories[0]?.group || '', step: 0, answers: {} };
  const inCategory = () => products.filter((p) => p.category === state.category);

  // 品類很多時分兩層：先選大類（廚房與用水…），再選品類；沒有大類資料就只顯示品類
  function renderCats() {
    const list = groups.length ? categories.filter((c) => c.group === state.group) : categories;
    const groupRow = groups.length
      ? `<div class="cat-row" role="group" aria-label="選擇大類">${groups.map((g) => `<button type="button" class="grp-btn" data-group="${esc(g)}" aria-pressed="${g === state.group}">${esc(g)}</button>`).join('')}</div>`
      : '';
    catsEl.innerHTML = groupRow + `<div class="cat-row" role="group" aria-label="選擇品類">${list
      .map((c) => `<button type="button" data-cat="${esc(c.slug)}" aria-pressed="${c.slug === state.category}">${esc(c.name)}</button>`)
      .join('')}</div>`;
  }

  function renderResult(qs) {
    const picks = pickProducts(inCategory(), state.answers).slice(0, 3);
    if (!picks.length) {
      bodyEl.innerHTML = '<p class="q">這個品類目前沒有商品。</p>';
      return;
    }
    const link = (p, slot) => `/go/${esc(p.channel)}-${esc(p.code)}`;
    const attrs = (p, slot) => `href="${link(p)}" rel="sponsored nofollow noopener" data-track="go" data-channel="${esc(p.channel)}" data-code="${esc(p.code)}" data-slot="${slot}"`;
    const chName = (p) => channels[p.channel] || p.channel;
    const official = (p) => (p.officialStore ? '<span class="badge official">官方</span>' : '');
    const [{ p, reasons }] = picks;
    const parts = [`標價 ${fmt(p.price)}`];
    if (p.discount) parts.push(`折扣 −${fmt(p.discount)}`);
    if (p.taxRefund) parts.push(`退稅／補助 −${fmt(p.taxRefund)}`);
    const hero = `<div class="result">
      <p class="q" style="margin:0">最適合你的是：${esc(p.name)}${official(p)}</p>
      ${p.img ? `<a ${attrs(p, 'finder')}><img class="thumb" src="${esc(p.img)}" alt="${esc(p.imgAlt || p.name)}" loading="lazy" style="max-width:360px;border-radius:8px"></a>` : ''}
      ${reasons.length ? `<div class="why">${reasons.map((r) => `<span class="chip hit">${esc(r)}</span>`).join('')}</div>` : ''}
      <div class="price"><b class="num">${fmt(p.final)}</b> <span class="note">到手價</span></div>
      ${parts.length > 1 ? `<p class="math num">${parts.join(' ')} = ${fmt(p.final)}</p>` : ''}
      ${p.badge ? `<span class="badge">${esc(p.badge)}</span>` : ''}
      ${p.strength ? `<p class="strength-line">${esc(p.strength)}</p>` : ''}
      <p class="flaw-line">注意：${esc(p.flaw)}</p>
      <p class="hist-line">${esc(histLine(p.hist, fmt))}</p>
      <div><a class="btn" ${attrs(p, 'finder')}>到${esc(chName(p))}看最新價格</a></div>
    </div>`;
    let cmp = '';
    if (picks.length > 1) {
      const keys = [];
      picks.forEach(({ p }) => (p.specs || []).forEach((s) => { if (!keys.includes(s.key)) keys.push(s.key); }));
      const cell = (p, k) => { const s = (p.specs || []).find((x) => x.key === k); return s ? esc(s.value + (s.unit ? ' ' + s.unit : '')) : '—'; };
      const rows = [
        ['到手價', (p) => `<b class="num">${fmt(p.final)}</b>`],
        ...keys.map((k) => [k, (p) => cell(p, k)]),
        ['缺點', (p) => esc(p.flaw)],
      ];
      cmp = `<div class="cmp-wrap"><p class="q" style="margin:14px 0 6px">前 ${picks.length} 名比較</p>
        <div class="scroll"><table class="cmp"><thead><tr><th></th>${picks.map(({ p }, i) => `<th scope="col">${i === 0 ? '<span class="chip hit">最推薦</span> ' : ''}<a href="/${esc(p.category)}/${esc(p.slug)}/">${esc(p.name)}</a>${official(p)}</th>`).join('')}</tr></thead>
        <tbody>${rows.map(([label, fn]) => `<tr><th scope="row">${esc(label)}</th>${picks.map(({ p }) => `<td>${fn(p)}</td>`).join('')}</tr>`).join('')}
        <tr><th scope="row"></th>${picks.map(({ p }) => `<td><a class="btn small" ${attrs(p, 'finder-compare')}>到${esc(chName(p))}看價格</a></td>`).join('')}</tr></tbody></table></div></div>`;
    }
    bodyEl.innerHTML = hero + cmp + `<button type="button" class="link-btn" data-restart>重新選一次</button>
      <p class="note">價格以賣場頁面為準，實際金額含券與運費請在結帳頁確認。</p>`;
    stepsEl.innerHTML = qs.map(() => '<i class="on"></i>').join('');
  }

  // 下方「主力推薦」只留目前選的品類；該品類沒有主力商品時顯示全部，不留空白
  function syncGrid() {
    const cards = Array.from(document.querySelectorAll('#featured-grid [data-category]'));
    const match = cards.filter((c) => c.getAttribute('data-category') === state.category);
    // 選了品類：該品類全部商品（含非主力）；找不到就退回主力商品
    const show = match.length ? match : cards.filter((c) => !c.hasAttribute('data-more'));
    cards.forEach((c) => ((c as HTMLElement).style.display = show.includes(c) ? '' : 'none'));
    const n = document.getElementById('featured-count');
    if (n) n.textContent = String(show.length);
  }

  function render() {
    syncGrid();
    renderCats();
    const qs = questionsFor(inCategory());
    stepsEl.innerHTML = qs.map((_, i) => `<i class="${i <= state.step ? 'on' : ''}"></i>`).join('');
    if (state.step >= qs.length) return renderResult(qs);
    const q = qs[state.step];
    bodyEl.innerHTML = `<p class="q">${esc(q.title)}</p>
      <div class="opts">${q.options.map((o, i) => `<button type="button" data-opt="${i}">${esc(o.label)}</button>`).join('')}</div>`;
  }

  document.getElementById('finder')?.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target : null;
    const cat = t?.closest('[data-cat]');
    const grp = t?.closest('[data-group]');
    const opt = t?.closest('[data-opt]');
    if (grp) {
      state.group = grp.getAttribute('data-group') || '';
      state.category = categories.find((c) => c.group === state.group)?.slug ?? state.category;
      state.step = 0;
      state.answers = {};
      render();
    } else if (cat) {
      state.category = cat.getAttribute('data-cat');
      state.step = 0;
      state.answers = {};
      render();
    } else if (opt) {
      const q = questionsFor(inCategory())[state.step];
      const o = q.options[Number(opt.getAttribute('data-opt'))];
      state.answers[q.key] = o.value;
      // 空間的答案同步寫入共享畫像；「中間」不代表大或小，不寫入
      if (q.key === 'area' && o.space) Profile.set({ spaceSize: o.space, answered: true });
      state.step++;
      render();
      bodyEl.querySelector('a,button')?.focus({ preventScroll: true });
    } else if (t?.closest('[data-restart]')) {
      state.step = 0;
      state.answers = {};
      render();
    }
  });

  if (categories.length) render();
</script>
