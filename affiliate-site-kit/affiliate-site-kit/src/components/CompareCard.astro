---
// 比較卡（情境頁、品類頁共用）：型號連到自己的評測頁、到手價算式、缺點、CTA 走 /go/。
import channelsData from '../data/channels.json';
import { priceBreakdown } from '../lib/pricing.mjs';
import { primaryChannel, productName } from '../lib/catalog.mjs';
import { money } from '../lib/format.mjs';
import { Image } from 'astro:assets';

const images = import.meta.glob('../assets/products/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;

interface Props {
  product: any;
  slot?: string;
}
const { product: p, slot = 'grid' } = Astro.props;
const b = priceBreakdown(p);
const ch = primaryChannel(p);
const chName = channelsData.channels.find((c) => c.id === ch)?.name ?? ch;
const img = p.image?.file ? images[`../assets/products/${p.image.file}`]?.default : undefined;
const onSale = !p.priceUnverified && b.discount > 0;
const zhe = onSale ? (Math.round((b.final / b.price) * 100) / 10).toString().replace(/\.0$/, '') : '';
const parts = [`標價 ${money(b.price)}`];
if (b.discount) parts.push(`現折 −${money(b.discount)}`);
if (b.taxRefund) parts.push(`退稅／補助 −${money(b.taxRefund)}`);
---
<li class="panel res" data-code={p.modelCode}>
  {img && (
    <a href={`/${p.category}/${p.slug}/`} class="block" aria-label={`${productName(p)}：看評測與規格`} style="background:#fff;border-radius:8px;margin-bottom:8px">
      <Image src={img} alt={p.image.alt} widths={[240, 480]} sizes="(min-width: 768px) 240px, 100vw" style="width:100%;height:180px;object-fit:contain;padding:8px" />
    </a>
  )}
  <div class="row">
    <h3 class="name"><a href={`/${p.category}/${p.slug}/`}>{productName(p)}</a>{p.officialStore && <span class="badge official">官方</span>}</h3>
    <div class="price num">
      {p.priceUnverified ? '價格請至蝦皮查看' : money(b.final)}
      {onSale && <div style="font-size:12px;font-weight:600"><s style="opacity:.6">{money(b.price)}</s> <span style="color:#e11d48">{p.promoBadge || '優惠價'}・{zhe} 折</span></div>}
    </div>
  </div>
  {!p.priceUnverified && parts.length > 1 && <p class="note num" style="margin:0">到手價 = {parts.join(' ')}</p>}
  <p class="flaw-line">缺點：{p.flaw}</p>
  <p style="margin:0">{p.tldr}</p>
  <div class="actions">
    <a class="btn small ghost" href={`/${p.category}/${p.slug}/`}>看評測與規格</a>
    <a class="btn small" href={`/go/${ch}-${p.modelCode}`} rel="sponsored nofollow noopener" data-track="go" data-channel={ch} data-code={p.modelCode} data-slot={slot}>到{chName}看最新價格</a>
  </div>
</li>
