---
// 比較卡（情境頁、品類頁共用）：型號連到自己的評測頁、到手價算式、缺點、CTA 走 /go/。
import channelsData from '../data/channels.json';
import { priceBreakdown } from '../lib/pricing.mjs';
import { primaryChannel, productName } from '../lib/catalog.mjs';
import { money } from '../lib/format.mjs';
import { Image } from 'astro:assets';

const images = import.meta.glob('../assets/products/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;

interface Props {
  product: any;
  slot?: string;
}
const { product: p, slot = 'grid' } = Astro.props;
const b = priceBreakdown(p);
const ch = primaryChannel(p);
const chName = channelsData.channels.find((c) => c.id === ch)?.name ?? ch;
const img = p.image?.file ? images[`../assets/products/${p.image.file}`]?.default : undefined;
const onSale = !p.priceUnverified && b.discount > 0;
const zhe = onSale ? (Math.round((b.final / b.price) * 100) / 10).toString().replace(/\.0$/, '') : '';
const keySpecs = (p.specs ?? []).filter((x: any) => x.value && x.value !== '待補').slice(0, 3);
const showTldr = p.tldr && !String(p.tldr).includes('整理中');
const parts = [`標價 ${money(b.price)}`];
if (b.discount) parts.push(`現折 −${money(b.discount)}`);
if (b.taxRefund) parts.push(`退稅／補助 −${money(b.taxRefund)}`);
---
<li class="panel res cmp" data-code={p.modelCode}>
  <a href={`/${p.category}/${p.slug}/`} class="cmp-img" aria-label={`${productName(p)}：看評測與規格`}>
    {img
      ? <Image src={img} alt={p.image.alt} widths={[240, 480]} sizes="(min-width: 640px) 200px, 112px" />
      : <span aria-hidden="true">圖片待補</span>}
  </a>
  <div class="cmp-main">
    <h3 class="name"><a href={`/${p.category}/${p.slug}/`}>{productName(p)}</a>{p.officialStore && <span class="badge official">官方</span>}</h3>
    {keySpecs.length > 0 && (
      <ul class="cmp-specs">
        {keySpecs.map((x: any) => <li><span>{x.key}</span> <b class="num">{x.value}{x.unit ? ` ${x.unit}` : ''}</b></li>)}
      </ul>
    )}
    <div class="cmp-price">
      {p.priceUnverified
        ? <span class="price">價格請至蝦皮查看</span>
        : <>
            <span class="cmp-label">到手價</span>
            <b class="price num">{money(b.final)}</b>
            {onSale && <s class="num">{money(b.price)}</s>}
            {onSale && <span class="cmp-off">{p.promoBadge || '優惠價'}・{zhe} 折</span>}
          </>}
    </div>
    {!p.priceUnverified && parts.length > 1 && <p class="note num cmp-calc">{parts.join(' ')}</p>}
    <p class="flaw-line">缺點：{p.flaw}</p>
    {showTldr && <p class="cmp-tldr">{p.tldr}</p>}
  </div>
  <div class="cmp-cta">
    <a class="btn cta-main" href={`/go/${ch}-${p.modelCode}`} rel="sponsored nofollow noopener" data-track="go" data-channel={ch} data-code={p.modelCode} data-slot={slot}>到{chName}看最新價格</a>
    <a class="cmp-more" href={`/${p.category}/${p.slug}/`}>看評測與規格</a>
  </div>
</li>
