---
// 商品卡片（單欄）：手機 100% 寬，桌面左 1/3 方形商品圖、右 2/3 規格與價格。
// 沒有資料的欄位（缺點整理中、沒有價格紀錄等）直接不渲染。連結走 /go/（HTML 不出現賣場網址）。
import { Image } from 'astro:assets';
import { priceBreakdown } from '../lib/pricing.mjs';
import { productName, primaryChannel, histSummary, histLine } from '../lib/catalog.mjs';

interface Props {
  product: any;
  categoryName: string;
  slot?: string;
  history?: Record<string, any[]>;
  more?: boolean;
}
const { product: p, categoryName, slot = 'grid', history = {}, more = false } = Astro.props;
const b = priceBreakdown(p);
const hasPromo = b.active && (b.discount > 0 || b.taxRefund > 0);
const ch = primaryChannel(p);
const fmt = new Intl.NumberFormat('zh-TW', { style: 'currency', currency: 'TWD', maximumFractionDigits: 0 });
const h = histSummary(history, p);
const histText = h?.enough && !h.demo ? histLine(h, (n: number) => fmt.format(n)) : '';

const images = import.meta.glob('../assets/products/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const img = p.image?.file ? images[`../assets/products/${p.image.file}`]?.default : undefined;

const PLACEHOLDER = /整理中|待補|待確認/;
const flaw = p.flaw && !PLACEHOLDER.test(p.flaw) ? p.flaw : '';
const strength = p.strength && !PLACEHOLDER.test(p.strength) ? p.strength : '';
const specChips = (p.specs ?? [])
  .filter((s: any) => s.value && !PLACEHOLDER.test(String(s.value)))
  .slice(0, 3)
  .map((s: any) => `${s.key} ${s.value}${s.unit ? ' ' + s.unit : ''}`);
const points = [...(strength ? [strength] : []), ...specChips].slice(0, 4);

const detail = `/${p.category}/${p.slug}/`;
// 有真實折扣才顯示「限時特價」大標籤與原價；折數 = 到手價 ÷ 標價
const unverified = !!p.priceUnverified; // 價格還沒跟蝦皮頁面核對：不顯示數字
const onSale = !unverified && b.active && b.discount > 0 && b.final < b.price;
const saleLabel = p.promoBadge || '優惠價';
const zhe = onSale ? (Math.round((b.final / b.price) * 100) / 10).toString().replace(/\.0$/, '') : '';
const area = p.finder?.area;
// 官方賣場且有真實折扣才寫「領券」，其餘不宣稱沒有資料的優惠
const cta = unverified ? '👉 前往蝦皮查看最新價格 ➔' : p.officialStore ? (b.discount > 0 ? '👉 前往官方旗艦館領券下單 ➔' : '👉 前往官方旗艦館下單 ➔') : '👉 前往蝦皮看最新價格 ➔';
const priceParts: string[] = [`標價 ${fmt.format(b.price)}`];
if (b.discount) priceParts.push(`現折 −${fmt.format(b.discount)}`);
if (b.taxRefund) priceParts.push(`退稅／補助 −${fmt.format(b.taxRefund)}`);
---
<article
  class="pcard overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md"
  data-category={p.category}
  data-finder-tags={(p.finder?.tags ?? []).join(' ') || undefined}
  data-more={more ? '' : undefined}
  data-final={unverified ? undefined : b.final}
  data-area-min={area ? area[0] : undefined}
  data-area-max={area ? area[1] : undefined}
  style={more ? 'display:none' : undefined}
>
  <div class="md:flex">
    <a href={detail} class="block bg-white md:w-1/3 md:shrink-0" aria-label={`${productName(p)}：看評測與規格`}>
      <div class="flex aspect-square w-full items-center justify-center bg-white p-4">
        {img
          ? <Image class="h-full w-full object-contain" src={img} alt={p.image.alt} widths={[240, 480, 720]} sizes="(min-width: 768px) 360px, 100vw" />
          : <span class="text-4xl font-bold text-slate-300" aria-hidden="true">{categoryName.slice(0, 2)}</span>}
      </div>
    </a>

    <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-slate-500">{categoryName}</span>
        {p.officialStore && <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">官方</span>}
        {!unverified && b.taxRefund > 0 && <span class="rounded-md bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-600">退稅／補助 −{fmt.format(b.taxRefund)}</span>}
      </div>

      <h3 class="text-base font-bold leading-snug text-slate-900 md:text-lg"><a href={detail} class="text-inherit no-underline hover:underline">{productName(p)}</a></h3>

      {points.length > 0 && (
        <ul class="space-y-1.5">
          {points.map((t: string) => (
            <li class="flex items-start gap-2 text-sm leading-relaxed text-slate-700">
              <svg class="mt-1 h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      )}

      {flaw && (
        <div class="rounded-lg bg-amber-50 px-3 py-2.5 text-sm leading-relaxed text-amber-800">
          <p>缺點：{flaw}</p>
          {p.flawBasis && <p class="mt-1 text-xs text-amber-800/70">依據：{p.flawBasis}</p>}
        </div>
      )}

      <div class="mt-auto flex flex-col gap-1.5">
        {onSale && <p data-dwell-hint class="dwell-hint w-fit rounded-md bg-rose-50 px-2 py-1 text-xs font-bold text-rose-700 ring-1 ring-rose-200">⚡ 限時特價中，現折 {fmt.format(b.discount)}{p.promoValidUntil ? ` · 活動至 ${String(p.promoValidUntil).slice(5,10).replace('-','/')}` : ''}</p>}
        {unverified ? (
          <div class="flex flex-col gap-0.5">
            <b class="text-xl font-extrabold text-slate-900">價格請至蝦皮查看</b>
            <span class="text-xs text-slate-500">賣場標價與限時特價會隨時調整，以蝦皮頁面為準</span>
          </div>
        ) : (<>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
          <span class="text-xs text-slate-500">到手價</span>
          <b class="num text-3xl font-extrabold tracking-tight text-slate-900">{fmt.format(b.final)}</b>
          {onSale && <s class="num text-base text-slate-400">{fmt.format(b.price)}</s>}
          {onSale && <span class="text-xs font-semibold text-slate-500">{saleLabel}・{zhe} 折</span>}
        </div>
        </>)}
        {!unverified && priceParts.length > 1 && <p class="num text-xs text-slate-500">{priceParts.join('　')} = {fmt.format(b.final)}</p>}
        {!unverified && histText && <p class="text-xs text-slate-500">{histText}</p>}
      </div>

      <a
        class="flex min-h-12 w-full items-center justify-center rounded-lg bg-gradient-to-r from-orange-500 to-orange-600 px-4 text-base font-bold text-white no-underline transition hover:from-orange-600 hover:to-orange-700 active:scale-[0.98]"
        href={`/go/${ch}-${p.modelCode}`}
        rel="sponsored nofollow noopener"
        data-track="go"
        data-cta
        data-channel={ch}
        data-code={p.modelCode}
        data-slot={slot}
      >{cta}</a>
    </div>
  </div>
</article>
