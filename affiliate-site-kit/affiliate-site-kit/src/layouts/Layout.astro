---
import '../styles/global.css';
import InAppWarning from '../components/InAppWarning.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string | false; // false = 不輸出 canonical（例如 404 頁）
  ogImage?: string;
  noindex?: boolean;
}
// ogImage 沒指定時用站級預設分享圖（public/og-default.png，1200×630）
const { title, description = '', canonical, ogImage = '/og-default.png', noindex = false } = Astro.props;
const canonicalUrl = canonical === false ? undefined : canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && ogImage === '/og-default.png' && <meta property="og:image:width" content="1200" />}
    {ogUrl && ogImage === '/og-default.png' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8fafc" />
  </head>
  <body>
    <InAppWarning />
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">挑家電</a>
        <nav class="nav" aria-label="主選單">
          <a href="/">回首頁</a>
          <a href="/guides/">買前指南</a>
          <a href="/#categories">全部品類</a>
          <a href="/about/">關於本站</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-foot">
      <div class="wrap">
        <p>本站部分連結為分潤連結，您購買時不會多花費用，我們可能因此獲得佣金。價格與優惠以賣場頁面為準。</p>
        <p><a href="/">回首頁</a>　<a href="/guides/">買前指南</a>　<a href="/about/">關於本站</a>　<a href="/disclosure/">分潤揭露</a>　<a href="/privacy/">隱私權政策</a></p>
      </div>
    </footer>
    <script>
      import { initTrack } from '../lib/track.js';
      // 點擊追蹤方案未定（BUILD_LOG 決策表）：先不送 endpoint，有 Umami／Plausible 才會送出
      initTrack();
    </script>
  </body>
</html>
