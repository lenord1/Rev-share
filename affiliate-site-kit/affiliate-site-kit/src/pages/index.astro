---
import Layout from '../layouts/Layout.astro';
import SmartFinder from '../components/SmartFinder.astro';
import SmartSearch from '../components/SmartSearch.astro';
import ProfileBar from '../components/ProfileBar.astro';
import QuizDialog from '../components/QuizDialog.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';
import channelsData from '../data/channels.json';
import { getImage } from 'astro:assets';
import { slimProduct, activeCategories, featuredProducts, safeJson } from '../lib/catalog.mjs';
const histFiles = import.meta.glob('../data/price-history.json', { eager: true }) as Record<string, { default: Record<string, { date: string; channel: string; price: number }[]> }>;
const history = Object.values(histFiles)[0]?.default ?? {};
import intentsData from '../data/intents.json';
import siteData from '../data/site.json';
import config from '../../scripts/config.json';
import { buildableIntents } from '../lib/intents.mjs';

const now = Date.now();
const categories = activeCategories(productsData);
const catName = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const featured = featuredProducts(productsData.products);
const more = productsData.products.filter((p) => !featured.includes(p));
const latest = productsData.products.map((p) => p.priceUpdatedAt).sort().at(-1) ?? '';
const updated = latest.replaceAll('-', '/');

const imageFiles = import.meta.glob('../assets/products/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const thumbs: Record<string, string> = {};
for (const p of productsData.products as any[]) {
  const meta = p.image?.file ? imageFiles[`../assets/products/${p.image.file}`]?.default : undefined;
  if (meta) thumbs[p.modelCode] = (await getImage({ src: meta, width: 360, format: 'webp' })).src;
}
// 傳給 client 的資料只帶精靈與搜尋需要的欄位，建置期內嵌，不另行 fetch
const catalog = {
  categories: categories.map((c) => ({ slug: c.slug, name: c.name, group: c.group ?? '' })),
  products: productsData.products.map((p: any) => ({
    ...slimProduct(p, now, history),
    img: thumbs[p.modelCode] ?? '',
    imgAlt: p.image?.alt ?? '',
    specs: (p.specs ?? []).map((s: any) => ({ key: s.key, value: s.value, unit: s.unit ?? '' })),
  })),
  channels: Object.fromEntries(channelsData.channels.map((c) => [c.id, c.name])),
};
const intents = buildableIntents(productsData.products, intentsData.intents, { minProducts: config.minIntentProducts ?? 2 });
// 網站名稱的結構化資料（讓搜尋結果顯示站名）
const websiteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: siteData.name, url: new URL('/', Astro.site!).href };
const groups = [...new Set(categories.map((c: any) => c.group ?? ''))];
const count = (slug: string) => productsData.products.filter((p) => p.category === slug).length;
---
<Layout title="挑家電｜三題找到適合你家的那一台" description="每台都列出一個真實缺點和扣掉折扣、退稅後的到手價，看完直接去賣場下單。">
  <main class="wrap">
    <section class="hero">
      <h1>三題找到適合你家的那一台</h1>
      <p>每台都列出一個真實缺點和扣掉折扣、退稅後的到手價，看完直接去賣場下單。</p>
      <p class="disclosure">本站部分連結為分潤連結，您購買時不會多花費用。</p>
      <ProfileBar />
      <SmartFinder />
    </section>

    <div class="grid-h"><h2>推薦商品 <span id="featured-count">{featured.length}</span> 台</h2>{updated && <span class="note num">價格更新：{updated}</span>}</div>
    <section class="grid" id="featured-grid" aria-label="主力商品">
      {featured.map((p) => <ProductCard product={p} categoryName={catName[p.category]} history={history} />)}
      {more.map((p) => <ProductCard product={p} categoryName={catName[p.category]} history={history} more />)}
    </section>

    <div class="grid-h"><h2>用自己的話找</h2></div>
    <SmartSearch />

    <div class="grid-h" id="categories"><h2>依品類慢慢看（{categories.length} 類）</h2></div>
    {groups.map((g) => (
      <section aria-label={g || '品類'}>
        {g && <h3 class="grp">{g}</h3>}
        <div class="cats2">
          {categories.filter((c: any) => (c.group ?? '') === g).map((c) => <a href={`/${c.slug}/`}>{c.name}<span>{count(c.slug)} 款整理</span></a>)}
        </div>
      </section>
    ))}

    {intents.length > 0 && <>
      <div class="grid-h"><h2>依情境挑</h2></div>
      <section class="cats2" aria-label="情境">
        {intents.map((n) => <a href={`/${n.category}/for/${n.slug}/`}>{n.title}<span>{Math.min(n.products.length, 4)} 款比較</span></a>)}
      </section>
    </>}
  </main>
  <QuizDialog />
  <script type="application/json" id="catalog" set:html={safeJson(catalog)} />
  <script type="application/ld+json" set:html={safeJson(websiteLd)} />
</Layout>
